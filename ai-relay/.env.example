# 复制本文件为 .env 后填写（.env 已被 .gitignore 忽略，不会进版本库）

# ---------------------------------------------------------------
# 中转站自身的主密钥：自己设一串强口令。
# 所有下游客户端（Codex / WorkBuddy / 自己的脚本）用它做 Bearer token，
# 跟你各家平台的 API Key 无关。
# ---------------------------------------------------------------
LITELLM_MASTER_KEY=sk-local-relay-change-me

# ---------------------------------------------------------------
# 上游平台 API Key —— 只填开放平台的 key，不是网页版/App 会员
# ---------------------------------------------------------------

# Kimi 开放平台（K3 / K2.7 Code / K2.6）
#   https://platform.kimi.com/console/api-keys
MOONSHOT_API_KEY=

# 火山方舟 / 豆包（doubao-seed 系列，Model ID 直连）
#   https://console.volcengine.com/ark → API Key 管理
ARK_API_KEY=

# 可选：OpenAI 平台 API 余额（platform.openai.com，不是 ChatGPT 订阅）
# OPENAI_API_KEY=
